    "@effect/vitest": "4.0.1",
    "@types/node": "24.13.6",
    "alchemy": "2.0.0-beta.81",
    "effect": "4.0.1",
    "oxfmt": "0.68.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "alchemy": ">=2.0.0-beta.81 <2.0.0-beta.84",
    "effect": "^4.0.0"
  },
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=11.1.2"
  },
  "packageManager": "pnpm@11.28.2"
